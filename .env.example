# Run npm run setup to generate a private .env with random local secrets.
MODE=MOCK_MODE
LIVE_ACTIVATED=false
DATABASE_URL=postgresql://commerce_app:GENERATED@localhost:55432/commerce
MIGRATION_DATABASE_URL=postgresql://commerce_owner:GENERATED@localhost:55432/commerce
TEST_DATABASE_URL=postgresql://commerce_app:GENERATED@localhost:55432/commerce_test
TEST_MIGRATION_DATABASE_URL=postgresql://commerce_owner:GENERATED@localhost:55432/commerce_test
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
N8N_DB_PASSWORD=
INTERNAL_TOKEN=
N8N_ENCRYPTION_KEY=
RUNNER_AUTH_TOKEN=
MOCK_WEBHOOK_SECRET=
INVENTORY_URL=http://127.0.0.1:3001
GATEWAY_URL=http://127.0.0.1:3100
N8N_URL=http://127.0.0.1:5678
MOCK_URL=http://127.0.0.1:3002
STORES_FILE=config/stores.live.json
SHIPPO_TOKEN=
SLACK_TOKEN=
SLACK_CHANNEL=
SHOPIFY_API_VERSION=2026-10
SHIPPO_API_VERSION=2018-02-08
RESERVATION_MINUTES=30
MAX_TRANSIT_DAYS=7
ALLOWED_SERVICES=ground,priority
PACKING_POLICY=per_unit
MAX_PARCELS=1000
MAX_PARCEL_WEIGHT_KG=25
MAX_PARCEL_SIDE_CM=120
API_TIMEOUT_MS=5000
RETRY_BASE_MS=200
ALLOW_METADATA_WRITES=false
INVENTORY_SNAPSHOT_URL=
INVENTORY_SNAPSHOT_TOKEN=
# Optional native development only: PostgreSQL tools directory; otherwise use PATH.
PG_BIN=
