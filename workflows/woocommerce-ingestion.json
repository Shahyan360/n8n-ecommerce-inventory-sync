    },
    "Read Durable Event Reference": {
      "main": [
        [
          {
            "node": "Shared Order Processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 90,
    "errorWorkflow": "commerceErrors",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
